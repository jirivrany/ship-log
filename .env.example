# Strava API application credentials — create one at https://www.strava.com/settings/api
# (set the Authorization Callback Domain to: localhost)
# Copy this file to .env; docker compose picks it up automatically.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Production only (docker-compose.prod.yml). Must match the Strava app's
# Authorization Callback Domain. Leave unset locally.
# STRAVA_REDIRECT_URI=https://<your-domain>/strava/callback

# Production only: host uid:gid the container runs as, so bind-mounted data/
# is owned by the app account rather than root. See DEPLOYMENT.md §4.3.
# Set with:  echo "UID_GID=$(id -u):$(id -g)" >> .env
# UID_GID=1001:1001
